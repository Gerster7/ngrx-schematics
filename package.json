{
	"name": "ngrx-schematic",
	"version": "1.3.1",
	"description": "Schematic para generar estados NgRx (actions, reducer, selectors, effects) en Angular",
	"keywords": [
		"angular",
		"schematics",
		"ngrx",
		"store",
		"state"
	],
	"license": "MIT",
	"main": "dist/collection.json",
	"schematics": "./dist/collection.json",
	"files": [
		"dist"
	],
	"scripts": {
		"clean": "node -e \"require('fs').rmSync('dist', { recursive: true, force: true })\"",
		"build": "npm run clean && tsc -p tsconfig.json && npm run copy:json && npm run copy:files",
		"test": "npm run build && node --test \"test/**/*.test.mjs\"",
		"prepublishOnly": "npm test",
		"copy:json": "copyfiles -u 1 \"src/**/*.json\" dist/",
		"copy:files": "copyfiles -u 1 \"src/state-schematic/files/**/*\" dist/"
	},
	"peerDependencies": {
		"@angular-devkit/core": ">=17.0.0",
		"@angular-devkit/schematics": ">=17.0.0"
	},
	"devDependencies": {
		"@angular-devkit/core": "^17.0.0",
		"@angular-devkit/schematics": "^17.0.0",
		"@angular/core": "^17.3.12",
		"@ngrx/effects": "^17.2.0",
		"@ngrx/entity": "^17.2.0",
		"@ngrx/store": "^17.2.0",
		"@types/node": "^22.18.0",
		"copyfiles": "^2.4.1",
		"rxjs": "^7.8.2",
		"typescript": "^5.0.0"
	}
}
